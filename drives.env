
#steamapps
UUID=d0b8e397-1c89-4e67-a5fb-7e24dcff1afd /home/icyjiub/.local/share/Steam/steamapps            btrfs   subvol=@steamapps,compress=zstd 0 0


#ExtraDrives
UUID=02f2f357-5109-427c-b735-4103c2029182 /mnt/NVME0                                            btrfs   subvol=root,defaults,discard=async,ssd,noatime,compress=zstd 0 0
UUID=bbb6087b-75e5-413f-9283-9065cb2396b1 /mnt/SSD3                                             btrfs   defaults,discard=async,ssd,noatime,compress=zstd 0 0
UUID=ab7ffd5c-1cb6-4e20-9168-3f9d3b26393e /mnt/Documents                                        btrfs   defaults,noatime,compress=zstd 0 0
UUID=c658b823-655d-4e67-8a9a-1c4d87313200 /mnt/Storage                                          btrfs   defaults,noatime,compress=zstd 0 0



#WindowsDrives With Overlay Mounts
UUID=22BC9DF4BC9DC2A9                     /mnt/Windows                                          lowntfs-3g    defaults,uid=1000,gid=1000,windows_names,noauto,prealloc 0 0
#mounts for lower readonly ntfs bottom layers
UUID=82C425D7C425CDEB /mnt/winOverlay/SSDWinLower ntfs-3g ro,defaults,windows_names,prealloc 0 0
UUID=78DBFD1A57D3E447 /mnt/winOverlay/SSD2WinLower ntfs-3g ro,defaults,windows_names,prealloc 0 0
#overlays
overlay /mnt/SSDWin overlay noauto,x-systemd.automount,defaults,lowerdir=/mnt/winOverlay/SSDWinLower,upperdir=/mnt/NVME0/NTFSOverlays/SSDWinUpper,workdir=/mnt/NVME0/NTFSOverlays/Merge/SSDWinMerge
overlay /mnt/SSD2Win overlay noauto,x-systemd.automount,defaults,lowerdir=/mnt/winOverlay/SSD2WinLower,upperdir=/mnt/NVME0/NTFSOverlays/SSD2WinUpper,workdir=/mnt/NVME0/NTFSOverlays/Merge/SSD2WinMerge